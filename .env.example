# Gemini API Key
GEMINI_API_KEY=your_api_key_here

# Mock Mode (개발용)
# true로 설정하면 실제 API 호출 없이 가짜 데이터를 반환합니다
# 디자인 작업이나 테스트 시 API 비용을 절약할 수 있습니다
USE_MOCK=false

# Gemini 모델 우선순위 (콤마로 구분)
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro

# Mock Payment (개발용)
USE_MOCK_PAYMENT=false
NEXT_PUBLIC_USE_MOCK_PAYMENT=false

# Preview Result (개발/검증용) - 티저 화면에서 전체 결과를 모의로 표시
NEXT_PUBLIC_PREVIEW_RESULT=false

# Toss Payments
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=

# Supabase (Client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
